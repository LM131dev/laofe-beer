# Database Configuration Example
# Copy this file to .env and adjust your database credentials safely.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=laofe_beer
DB_USER=laofe_dbuser
DB_PASS=SecurePassword123!
DB_CHARSET=utf8mb4

# Application Environment (production / development)
APP_ENV=development

# Email Notifications (Admin notification recipient & SMTP settings)
NOTIFICATION_EMAIL=info@laofecafe.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@laofecafe.com
MAIL_FROM_NAME="LaoFe & Beer Website"

# Anti-Spam Captcha Settings (Cloudflare Turnstile or Google reCAPTCHA)
# Leave blank to use built-in smart session Math CAPTCHA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
